NODE_ENV=production
PORT=3000

# Choose one database config style.
DATABASE_URL=
# Or:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change_me

JWT_SECRET=replace_with_a_long_random_secret
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://your-frontend.web.app,https://your-frontend.firebaseapp.com

AUTH_LOGIN_MAX_REQUESTS=20
AUTH_LOGIN_WINDOW_MS=300000
AUTH_REGISTER_MAX_REQUESTS=20
AUTH_REGISTER_WINDOW_MS=3600000

# Google OAuth Web Client ID, for example:
# 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_BROWSER_API_KEY=

APP_BASE_URL=https://your-domain.hu
# open_meteo needs no API key. Use accuweather only with ACCUWEATHER_API_KEY.
WEATHER_PROVIDER=open_meteo
ACCUWEATHER_API_KEY=

# SMTP / email delivery
SMTP_HOST=mail.your-domain.hu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=invite@your-domain.hu
SMTP_PASS=change_me
MAIL_FROM=invite@your-domain.hu
MAIL_FROM_NAME=Foci Szervező
REGISTRATION_NOTIFY_EMAIL=erhardtpeter.bm@gmail.com
