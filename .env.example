NODE_ENV=production
PORT=3000

# Choose one database config style.
DATABASE_URL=
# Or:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change_me

JWT_SECRET=replace_with_a_long_random_secret
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://your-frontend.web.app,https://your-frontend.firebaseapp.com

AUTH_LOGIN_MAX_REQUESTS=20
AUTH_LOGIN_WINDOW_MS=300000
AUTH_REGISTER_MAX_REQUESTS=20
AUTH_REGISTER_WINDOW_MS=3600000

GOOGLE_CLIENT_ID=
